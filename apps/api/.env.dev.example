COMPOSE_PROJECT_NAME=mstream-dev
API_PORT=3000
WEB_PORT=5173
POSTGRES_USER=mstream
POSTGRES_PASSWORD=change-me-dev
POSTGRES_DB=mstream_dev
DATABASE_URL=postgres://mstream:change-me-dev@postgres:5432/mstream_dev
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173
WEB_URL=http://localhost:5173
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Twitch OAuth redirect URI: http://localhost:3000/api/auth/callback/twitch
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Kick OAuth redirect URI: http://localhost:3000/api/auth/callback/kick

# Required only with the opt-in compose.tunnel.* override
CLOUDFLARE_TUNNEL_TOKEN=
