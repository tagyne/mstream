COMPOSE_PROJECT_NAME=mstream-prod
API_PORT=3000
WEB_PORT=8080
POSTGRES_USER=mstream
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_DB=mstream_prod
DATABASE_URL=postgres://mstream:replace-with-a-local-secret@postgres:5432/mstream_prod
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8080
WEB_URL=http://localhost:8080
TOKEN_ENCRYPTION_SECRET=replace-with-at-least-32-random-characters
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/platform-connections/twitch/callback
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:3000/platform-connections/kick/callback

# Required only with the opt-in compose.tunnel.* override
CLOUDFLARE_TUNNEL_TOKEN=
